{
  "name": "simbiat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write app components data lib styles tests scripts *.ts *.json README.md",
    "format:check": "prettier --check app components data lib styles tests scripts *.ts *.json README.md",
    "test": "node node_modules/@playwright/test/cli.js test",
    "screenshots": "npm run build && node node_modules/@playwright/test/cli.js test --grep screenshot && node scripts/screenshot-index.mjs",
    "export:pdf": "node scripts/export-prototype-pdf.mjs",
    "export:scope": "node scripts/export-scope-pdf.mjs",
    "export:foundations": "node scripts/export-foundation-progress.mjs",
    "archive:milestone": "node scripts/archive-milestone.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
