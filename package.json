{
  "name": "simbiat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "operations:setup": "tsx scripts/operations/setup.mts",
    "operations:mail": "tsx scripts/operations/mail.mts",
    "operations:test": "tsx --test tests/operations.test.ts",
    "operations:test-ui": "playwright test --config playwright.operations.config.ts",
    "operations:test-auth": "tsx scripts/operations/auth-smoke.mts",
    "operations:check": "tsx scripts/operations/check.mts",
    "payments:setup": "tsx scripts/payments/setup.mts",
    "payments:dev": "tsx scripts/payments/dev.mts",
    "payments:smoke": "tsx scripts/payments/smoke.mts",
    "payments:test-purchase": "tsx scripts/payments/purchase-test.mts",
    "payments:reconcile": "tsx scripts/payments/reconcile.mts",
    "payments:test": "tsx --test tests/payments.test.ts",
    "payments:test-ui": "playwright test --config playwright.payments.config.ts",
    "contentful:export": "node scripts/contentful/export.mjs",
    "contentful:plan": "node scripts/contentful/migrate.mjs",
    "contentful:import": "node scripts/contentful/migrate.mjs --apply",
    "contentful:verify": "node scripts/contentful/verify.mjs",
    "contentful:connect": "node scripts/contentful/connect.mjs",
    "contentful:webhook": "node scripts/contentful/webhook.mjs",
    "contentful:test": "node --test scripts/contentful/export.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "format": "prettier --write app components data lib styles tests scripts *.ts *.json README.md",
    "format:check": "prettier --check app components data lib styles tests scripts *.ts *.json README.md",
    "test": "node node_modules/@playwright/test/cli.js test",
    "screenshots": "npm run build && node node_modules/@playwright/test/cli.js test --grep screenshot && node scripts/screenshot-index.mjs",
    "export:pdf": "node scripts/export-prototype-pdf.mjs",
    "export:scope": "node scripts/export-scope-pdf.mjs",
    "export:foundations": "node scripts/export-foundation-progress.mjs",
    "archive:milestone": "node scripts/archive-milestone.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@clerk/ui": "^1.33.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@stripe/cli": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
